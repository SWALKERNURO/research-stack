{
  "name": "nurowerx-research-stack",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/research-console",
    "packages/nx-lens",
    "packages/nx-frame"
  ],
  "scripts": {
    "dev": "npm run dev -w @nurowerx/console",
    "build": "tsc --noEmit && vite build --config apps/research-console/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@tanstack/react-query": "5.107.1",
    "d3": "7.9.2",
    "lucide-react": "1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/d3": "^7.4.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
